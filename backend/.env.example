# Django Secret Key (change in production)
SECRET_KEY=django-insecure-highly-confidential-esg-carbonflow-platform-key-2026

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated, e.g., localhost,127.0.0.1)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Leave blank to use SQLite by default
# For PostgreSQL: postgres://user:password@host:port/dbname
DATABASE_URL=

# CORS Configuration
# Comma-separated list of origins allowed to access the APIs
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Token Settings (in minutes)
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_MINUTES=1440
